                        (k[batch, :, group].contiguous(), k_scale[batch, :, group].contiguous()),
                        weights[:, group * heads : (group + 1) * heads].contiguous(),
                        start,
                        end,
                        clean_logits=True,
                    )
                    for group in range(groups)
                ]
                batches.append(scores[0].unsqueeze(-1) if groups == 1 else torch.stack(scores, -1))
