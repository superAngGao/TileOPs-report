                HADACORE_TAG: Implementation(
                    run=hadacore.hadamard_transform,
                    noncomparable_reason=(
                        "rounds each order-16 tensor-core stage to the 16-bit input dtype; the "
                        "transform rounds once after float32 accumulation"
